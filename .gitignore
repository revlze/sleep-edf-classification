# Python and local environments
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
build/
dist/
.env
.env.*
!.env.example

# Input data and local results
data/*
!data/.gitkeep
artefacts/*
!artefacts/.gitkeep
submissions/*
!submissions/.gitkeep
mlruns/
mlartifacts/
mlflow.db
*.log

# Private working notes, reference snapshots and local checks
docs/*
!docs/.gitkeep
desc/
tests/*
!tests/.gitkeep
.linear.lock
experiments.csv.lock
experiments.csv.tmp

# Historical local data/results/notes stay private after repository reorganization
/archive/data/*
!/archive/data/.gitkeep
/archive/artefacts/*
!/archive/artefacts/.gitkeep
/archive/submissions/*
!/archive/submissions/.gitkeep
/archive/docs/*
!/archive/docs/.gitkeep
/archive/tests/*
!/archive/tests/.gitkeep
/archive/experiments.csv.lock

# Final outputs and teacher-only package, including personal information
/final/outputs/
/final/bundles/
/final/.pytest_cache/
/moodle_package/
/team_info.csv
/sleep-edf-moodle*.zip
